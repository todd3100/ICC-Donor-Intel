// ICC Donor Intelligence — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
}

enum ProspectStatus {
  hot
  warm
  cold
  connected
}

// Phase 2: pipeline / moves management stages.
// Ordered: identified -> researched -> warm_intro_made -> meeting_scheduled
//          -> cultivation -> ask_made -> closed_won -> closed_declined
enum ProspectStage {
  identified
  researched
  warm_intro_made
  meeting_scheduled
  cultivation
  ask_made
  closed_won
  closed_declined
}

enum DonorType {
  org
  individual
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String       @map("password_hash")
  name          String
  role          Role         @default(member)
  createdAt     DateTime     @default(now()) @map("created_at")

  prospectsAdded Prospect[]  @relation("ProspectAddedBy")
  notes          Note[]
  auditLogs      AuditLog[]
  tasksCreated   Task[]      @relation("TaskCreatedBy")

  @@map("users")
}

model Donor {
  id          String    @id @default(cuid())
  name        String    @unique
  type        DonorType @default(org)
  principals  String[]
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("donors")
  @@index([name])
}

model Prospect {
  id                    String         @id @default(cuid())
  name                  String
  status                ProspectStatus @default(cold)
  // Phase 2 additions:
  stage                 ProspectStage  @default(identified)
  owner                 String?
  suggestedAskMin       Int?           @map("suggested_ask_min")
  suggestedAskMax       Int?           @map("suggested_ask_max")
  suggestedAskOverride  Boolean        @default(false) @map("suggested_ask_override")
  lastStageChangeAt     DateTime?      @map("last_stage_change_at")

  tier                  Int            @default(3)
  age                   Int?
  location              String?
  undergrad             String?
  grad                  String?
  netWorth              String?        @map("net_worth")
  netWorthSource        String?        @map("net_worth_source")
  occupation            String?
  previousRoles         String[]       @map("previous_roles")
  campusConnections     String[]       @map("campus_connections")
  philanthropicFootprint String[]      @map("philanthropic_footprint")
  oct7Signals           String?        @map("oct7_signals")
  children              String?
  spouse                String?
  personalConnections   String?        @map("personal_connections")
  iccNetworkMatches     String[]       @map("icc_network_matches")
  connectionDetail      String?        @map("connection_detail")
  aiResearchCompleted   Boolean        @default(false) @map("ai_research_completed")
  aiResearchLastRun     DateTime?      @map("ai_research_last_run")
  aiResearchError       Boolean        @default(false) @map("ai_research_error")
  aiResearchErrorMsg    String?        @map("ai_research_error_msg")
  contacted             Boolean        @default(false)
  lastContactDate       DateTime?      @map("last_contact_date") @db.Date
  contactResponse       String?        @map("contact_response")
  addedById             String?        @map("added_by")
  addedBy               User?          @relation("ProspectAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  notes                 Note[]
  auditLogs             AuditLog[]
  tasks                 Task[]

  @@map("prospects")
  @@index([status])
  @@index([stage])
  @@index([tier])
  @@index([name])
}

model Note {
  id         String    @id @default(cuid())
  prospectId String    @map("prospect_id")
  prospect   Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("notes")
  @@index([prospectId])
}

// Phase 2 — Task tracking model.
//
// `assignedTo` is a free-text string rather than a User foreign key so that tasks can
// be assigned to staff members who don't have login accounts (e.g. "Jacob", "Shira",
// "Ian", "Rose", "Elisabeth"). The UI offers known names as suggestions but also
// accepts arbitrary strings.
//
// `createdById` IS a FK to User — we always know who created the task.
model Task {
  id           String    @id @default(cuid())
  prospectId   String    @map("prospect_id")
  prospect     Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  assignedTo   String?   @map("assigned_to")             // free-text staff name
  type         TaskType  @default(other)
  description  String
  dueDate      DateTime? @map("due_date") @db.Date

  completed    Boolean   @default(false)
  completedAt  DateTime? @map("completed_at")

  createdById  String?   @map("created_by")
  createdBy    User?     @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("tasks")
  @@index([prospectId])
  @@index([assignedTo])
  @@index([completed])
  @@index([dueDate])
}

enum TaskType {
  call
  email
  meeting
  research
  send_materials
  other
}

model AuditLog {
  id         String    @id @default(cuid())
  prospectId String?   @map("prospect_id")
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  userId     String?   @map("user_id")
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  detail     String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("audit_logs")
  @@index([prospectId])
  @@index([createdAt])
}
